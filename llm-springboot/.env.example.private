# =============================================================================
# LLM Spring Boot Workshop - Private AI Environment Configuration
# =============================================================================
# This configuration uses private AI models deployed on Red Hat MaaS
# API Base: https://litellm-prod.apps.maas.redhatworkshops.io/v1
#
# Copy this file to .env for private AI deployment
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Configuration (Private AI Endpoint)
# -----------------------------------------------------------------------------
# For private AI deployment, set API key (if required by your endpoint)
# Some private endpoints may not require authentication
OPENAI_API_KEY=your-private-api-key-or-leave-blank

# Private AI Base URL - Red Hat MaaS LiteLLM endpoint
OPENAI_API_BASE=https://litellm-prod.apps.maas.redhatworkshops.io/v1

# -----------------------------------------------------------------------------
# Model Configuration for Private AI
# -----------------------------------------------------------------------------

# Primary chat/generation model
# Recommended: deepseek-r1-distill-qwen-14b (strong reasoning capabilities)
# Alternative: qwen3-14b (balanced performance), llama-scout-17b (larger context)
OPENAI_MODEL_NAME=deepseek-r1-distill-qwen-14b

# Alternative chat models available:
# - qwen3-14b: Qwen 3 14B model for general-purpose chat
# - llama-scout-17b: Llama Scout 17B for extended context
# - codellama-7b-instruct: Code-focused model (use for code generation tasks)

# -----------------------------------------------------------------------------
# Embedding Model (Module 06)
# -----------------------------------------------------------------------------
# Used for vector embeddings and semantic search
OPENAI_EMBEDDING_MODEL=nomic-embed-text-v1-5

# -----------------------------------------------------------------------------
# Validation & Evaluation Models
# -----------------------------------------------------------------------------

# Module 05: Security validator model
# Llama Guard is specifically designed for content moderation and safety
OPENAI_VALIDATOR_MODEL=Llama-Guard-3-1B

# Module 06: Dokimos judge model for evaluation
# Use the stronger reasoning model for evaluation tasks
DOKIMOS_JUDGE_MODEL=deepseek-r1-distill-qwen-14b

# Alternative for judge (if you need faster evaluation):
# DOKIMOS_JUDGE_MODEL=qwen3-14b

# -----------------------------------------------------------------------------
# Redis Configuration (Modules 04, 05, 06)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Modules 03, 04)
# -----------------------------------------------------------------------------
POSTGRES_DB_MODULE03=workshop_module03
POSTGRES_USER_MODULE03=workshop
POSTGRES_PASSWORD_MODULE03=workshop123
POSTGRES_HOST_MODULE03=localhost
POSTGRES_PORT_MODULE03=5432

POSTGRES_DB_MODULE04=workshop_module04
POSTGRES_USER_MODULE04=workshop
POSTGRES_PASSWORD_MODULE04=workshop123
POSTGRES_HOST_MODULE04=localhost
POSTGRES_PORT_MODULE04=5432

# -----------------------------------------------------------------------------
# Grafana Configuration (Module 06)
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Model Selection Guide
# -----------------------------------------------------------------------------
#
# Available Models on Private AI:
#
# 1. deepseek-r1-distill-qwen-14b (Recommended for most tasks)
#    - Best for: Reasoning, analysis, complex queries
#    - Use for: Main chat, evaluation/judge
#    - Size: 14B parameters
#
# 2. qwen3-14b
#    - Best for: General-purpose chat, balanced performance
#    - Use for: Alternative main chat model
#    - Size: 14B parameters
#
# 3. llama-scout-17b
#    - Best for: Extended context, large document processing
#    - Use for: Long-form content, multi-document tasks
#    - Size: 17B parameters
#
# 4. codellama-7b-instruct
#    - Best for: Code generation, code explanation
#    - Use for: Programming-focused modules
#    - Size: 7B parameters
#
# 5. Llama-Guard-3-1B
#    - Best for: Content moderation, safety checks
#    - Use for: Security validation (Module 05)
#    - Size: 1B parameters (fast and efficient)
#
# 6. nomic-embed-text-v1-5
#    - Best for: Text embeddings, semantic search
#    - Use for: Vector embeddings (Module 06)
#    - Type: Embedding model
#
# -----------------------------------------------------------------------------
# Module-Specific Recommendations
# -----------------------------------------------------------------------------
#
# Module 02 (Advanced RAG):
#   OPENAI_MODEL_NAME=deepseek-r1-distill-qwen-14b
#   OPENAI_EMBEDDING_MODEL=nomic-embed-text-v1-5
#
# Module 03 (Tools & MCP):
#   OPENAI_MODEL_NAME=qwen3-14b
#   (Tools work well with general-purpose models)
#
# Module 04 (Chatbots to Agents):
#   OPENAI_MODEL_NAME=llama-scout-17b
#   (Extended context helps with multi-turn conversations)
#
# Module 05 (Security & Guardrails):
#   OPENAI_MODEL_NAME=deepseek-r1-distill-qwen-14b
#   OPENAI_VALIDATOR_MODEL=Llama-Guard-3-1B
#   (Llama Guard specifically designed for security validation)
#
# Module 06 (Enterprise Production):
#   OPENAI_MODEL_NAME=qwen3-14b
#   OPENAI_EMBEDDING_MODEL=nomic-embed-text-v1-5
#   DOKIMOS_JUDGE_MODEL=deepseek-r1-distill-qwen-14b
#   (Use stronger model for evaluation/judging)
#
# Code-focused tasks:
#   OPENAI_MODEL_NAME=codellama-7b-instruct
#   (Switch to CodeLlama for code generation/explanation)
#
# -----------------------------------------------------------------------------
# Performance Tuning
# -----------------------------------------------------------------------------
#
# Model selection based on requirements:
#
# Speed Priority:
#   - codellama-7b-instruct (7B, fastest)
#   - Llama-Guard-3-1B (1B, very fast for validation)
#
# Quality Priority:
#   - llama-scout-17b (17B, highest quality)
#   - deepseek-r1-distill-qwen-14b (14B, best reasoning)
#
# Balanced:
#   - qwen3-14b (14B, good balance)
#   - deepseek-r1-distill-qwen-14b (14B, versatile)
#
# Cost Priority:
#   - codellama-7b-instruct (smallest general model)
#   - Llama-Guard-3-1B (for security only)
#
# -----------------------------------------------------------------------------
# Testing Your Configuration
# -----------------------------------------------------------------------------
#
# After configuring, test the connection:
#
# curl https://litellm-prod.apps.maas.redhatworkshops.io/v1/models \
#   -H "Authorization: Bearer $OPENAI_API_KEY"
#
# This should list available models on the endpoint.
#
# -----------------------------------------------------------------------------
