# =============================================================================
# LLM Spring Boot Workshop - Master Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Each module uses a subset of these variables as needed
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Configuration (Required for all modules)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# API Base URL - change this if using a proxy or private AI endpoint
OPENAI_API_BASE=https://api.openai.com/

# Primary model for chat/generation
# Options: gpt-4o, gpt-4o-mini, gpt-4, gpt-3.5-turbo
# Module 02, 03, 04: Uses this for main chat
# Module 05: Uses this for main chat (default: gpt-4o)
# Module 06: Uses this for main chat (default: gpt-4o-mini)
OPENAI_MODEL_NAME=gpt-4o-mini

# -----------------------------------------------------------------------------
# OpenAI Embedding Model (Module 06)
# -----------------------------------------------------------------------------
# Used for vector embeddings and semantic search
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Validation & Evaluation Models
# -----------------------------------------------------------------------------
# Module 05: Validator model for security checks (lower cost, faster)
OPENAI_VALIDATOR_MODEL=gpt-4o-mini

# Module 06: Dokimos judge model for evaluation (needs stronger reasoning)
DOKIMOS_JUDGE_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Redis Configuration (Modules 04, 05, 06)
# -----------------------------------------------------------------------------
# Redis host - use 'localhost' for local Docker, or container name in compose
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (optional, not set by default in docker-compose)
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Modules 03, 04)
# -----------------------------------------------------------------------------
# Database connection for modules 03 and 04
# These are pre-configured in docker-compose but can be overridden here

# Module 03 Database
POSTGRES_DB_MODULE03=workshop_module03
POSTGRES_USER_MODULE03=workshop
POSTGRES_PASSWORD_MODULE03=workshop123
POSTGRES_HOST_MODULE03=localhost
POSTGRES_PORT_MODULE03=5432

# Module 04 Database
POSTGRES_DB_MODULE04=workshop_module04
POSTGRES_USER_MODULE04=workshop
POSTGRES_PASSWORD_MODULE04=workshop123
POSTGRES_HOST_MODULE04=localhost
POSTGRES_PORT_MODULE04=5432

# -----------------------------------------------------------------------------
# Server Ports (Optional - defaults shown)
# -----------------------------------------------------------------------------
# Override if you need different ports
# SERVER_PORT_MODULE01=8081
# SERVER_PORT_MODULE02=8082
# SERVER_PORT_MODULE03=8083
# SERVER_PORT_MODULE04=8084
# SERVER_PORT_MODULE05=8085
# SERVER_PORT_MODULE06=8086

# -----------------------------------------------------------------------------
# Grafana Configuration (Module 06)
# -----------------------------------------------------------------------------
# Grafana admin credentials for docker-compose
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Module-Specific Configuration
# -----------------------------------------------------------------------------

# Module 05: Security & Guardrails
# Enable/disable security features
# SECURITY_AUDIT_ENABLED=true
# SECURITY_PII_MASKING_ENABLED=true
# SECURITY_PROMPT_INJECTION_ENABLED=true

# Module 06: Enterprise Production
# Cache configuration
# SEMANTIC_CACHE_ENABLED=true
# SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
# SEMANTIC_CACHE_TTL_SECONDS=3600

# Token optimization
# TOKEN_OPTIMIZER_MAX_TOKENS=4000
# TOKEN_OPTIMIZER_COMPRESSION_ENABLED=true

# Evaluation dataset path
# EVALUATION_DATASET_PATH=data/eval-golden-set.json

# -----------------------------------------------------------------------------
# Usage by Module
# -----------------------------------------------------------------------------
#
# Module 01 (Vector Embeddings):
#   - No environment variables required
#
# Module 02 (Advanced RAG):
#   - OPENAI_API_KEY
#   - OPENAI_MODEL_NAME (default: gpt-4)
#   - OPENAI_API_BASE
#
# Module 03 (Tools & MCP):
#   - OPENAI_API_KEY
#   - OPENAI_MODEL_NAME (default: gpt-4o-mini)
#   - OPENAI_API_BASE
#   - PostgreSQL (via docker-compose)
#
# Module 04 (Chatbots to Agents):
#   - OPENAI_API_KEY
#   - OPENAI_MODEL_NAME (default: gpt-4o-mini)
#   - OPENAI_API_BASE
#   - PostgreSQL (via docker-compose)
#   - Redis (via docker-compose)
#
# Module 05 (Security & Guardrails):
#   - OPENAI_API_KEY (required)
#   - OPENAI_MODEL_NAME (default: gpt-4o)
#   - OPENAI_VALIDATOR_MODEL (default: gpt-4o-mini)
#   - REDIS_HOST, REDIS_PORT
#
# Module 06 (Enterprise Production):
#   - OPENAI_API_KEY (required)
#   - OPENAI_API_BASE
#   - OPENAI_MODEL_NAME (default: gpt-4o-mini)
#   - OPENAI_EMBEDDING_MODEL (default: text-embedding-3-small)
#   - DOKIMOS_JUDGE_MODEL (default: gpt-4o)
#   - REDIS_HOST, REDIS_PORT
#   - Prometheus, Grafana (via docker-compose)
#
# -----------------------------------------------------------------------------
